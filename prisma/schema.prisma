generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  phone     String?
  role      UserRole @default(guest)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings Booking[]
  reviews  Review[]

  @@map("users")
}

enum UserRole {
  guest
  hotel_admin
  super_admin
}

model Hotel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  tagline     String?
  description String?
  address     String?
  city        String?
  country     String?
  latitude    Float?
  longitude   Float?
  checkInTime String   @default("15:00") @map("check_in_time")
  checkOutTime String  @default("11:00") @map("check_out_time")
  policies    Json? // cancellation, pet, child policies stored as JSON
  amenities   String[] @default([])
  photos      String[] @default([])
  logoUrl     String?  @map("logo_url")
  currency    String   @default("EUR")
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roomTypes RoomType[]
  bookings  Booking[]
  reviews   Review[]

  @@map("hotels")
}

model RoomType {
  id          String   @id @default(cuid())
  hotelId     String   @map("hotel_id")
  name        String
  slug        String
  description String?
  bedType     String   @map("bed_type")
  maxGuests   Int      @map("max_guests")
  roomSize    Int?     @map("room_size") // square meters
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  extraGuestFee Decimal @default(0) @map("extra_guest_fee") @db.Decimal(10, 2)
  amenities   String[] @default([])
  photos      String[] @default([])
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms        Room[]
  availability Availability[]
  bookings     Booking[]

  @@unique([hotelId, slug])
  @@map("room_types")
}

model Room {
  id         String     @id @default(cuid())
  roomTypeId String     @map("room_type_id")
  roomNumber String     @map("room_number")
  floor      String?
  status     RoomStatus @default(available)
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("rooms")
}

enum RoomStatus {
  available
  maintenance
  out_of_order
}

model Availability {
  id             String   @id @default(cuid())
  roomTypeId     String   @map("room_type_id")
  date           DateTime @db.Date
  availableCount Int      @map("available_count")
  priceOverride  Decimal? @map("price_override") @db.Decimal(10, 2)
  isBlocked      Boolean  @default(false) @map("is_blocked")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([roomTypeId, date])
  @@map("availability")
}

model Booking {
  id              String        @id @default(cuid())
  userId          String?       @map("user_id")
  hotelId         String        @map("hotel_id")
  roomTypeId      String        @map("room_type_id")
  checkIn         DateTime      @map("check_in") @db.Date
  checkOut        DateTime      @map("check_out") @db.Date
  guestCount      Int           @map("guest_count")
  guestName       String        @map("guest_name")
  guestEmail      String        @map("guest_email")
  guestPhone      String?       @map("guest_phone")
  specialRequests String?       @map("special_requests")
  estimatedArrival String?      @map("estimated_arrival")
  status          BookingStatus @default(pending)
  totalPrice      Decimal       @map("total_price") @db.Decimal(10, 2)
  currency        String        @default("EUR")
  cancellationReason String?    @map("cancellation_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  hotel   Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  payments Payment[]
  review   Review?

  @@index([userId])
  @@index([hotelId, checkIn, checkOut])
  @@map("bookings")
}

enum BookingStatus {
  pending
  confirmed
  checked_in
  checked_out
  cancelled
}

model Payment {
  id                   String        @id @default(cuid())
  bookingId            String        @map("booking_id")
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("EUR")
  status               PaymentStatus @default(pending)
  stripePaymentIntentId String?      @map("stripe_payment_intent_id")
  paidAt               DateTime?     @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique @map("booking_id")
  userId    String?  @map("user_id")
  hotelId   String   @map("hotel_id")
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@map("reviews")
}
